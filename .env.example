# =============================================================================
# QUIZMASTER PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in the values for your environment.
# =============================================================================

# --- 1. Application & Flask Security ---
FLASK_SECRET_KEY=replace-with-secure-random-64-character-hex-string
FLASK_DEBUG=0
FLASK_HOST=0.0.0.0
PORT=5000
SESSION_COOKIE_SECURE=0
APP_BASE_URL=http://localhost:5000

# --- 2. Database Connection (MySQL / MariaDB) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=qcms_db
DB_USER=root
DB_PASSWORD=
# Optional SSL Certificate path for cloud databases (AWS RDS, PlanetScale, DigitalOcean, Azure):
# DB_SSL_CA=/path/to/ca-cert.pem

# --- 3. Email Notification Gateway (Brevo / Sendinblue) ---
BREVO_API_KEY=
SENDER_EMAIL=asr082239@gmail.com
SENDER_NAME=QuizMaster Admin

# --- 4. AI Question Generation (Groq Cloud API) ---
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- 5. Code Execution Engine (Judge0) ---
# Optional: Self-hosted or RapidAPI Judge0 instance for code questions
# JUDGE0_API_URL=http://localhost:2358
# RAPIDAPI_KEY=
